 std::string UserProfileDirectoryImpl::GetUserProfileDirectory() const {
+  if constexpr (port::IsIos()) {
+    const std::string data_home = Environ::GetEnv("FCITX_DATA_HOME");
+    return FileUtil::JoinPath(data_home, "mozc");
+  }
+  // Originally ~/Library/Application Support/Mozc on macOS and /tmp on wasm.
+  // Store user history in ~/.local/share/fcitx5 like pinyin and rime.
+  const std::string home = Environ::GetEnv("HOME");
+  return FileUtil::JoinPath(home, ".local/share/fcitx5/Mozc");
